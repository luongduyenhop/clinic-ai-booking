PROJECT_NAME="Clinic AI Booking Backend"
API_V1_STR="/api/v1"
DEBUG=False
ENVIRONMENT=development
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ENABLE_DEMO_SEED=false
ENABLE_OUTBOUND_NOTIFICATIONS=false

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_password
POSTGRES_DB=clinic_db
DATABASE_URL=postgresql+asyncpg://clinic_user:clinic_password@localhost:5432/clinic_db

SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME="Phòng Khám Đa Khoa AI"

AI_SERVICE_URL=http://localhost:8001/predict
AI_CONFIDENCE_THRESHOLD=0.40
CLS_UPLOAD_DIR=/app/uploads/cls
