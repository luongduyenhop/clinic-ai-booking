  tong_chuyen_khoan_he_thong numeric(15, 2) [not null]
  tong_the_pos_he_thong numeric(15, 2) [not null]
  tien_mat_thuc_te numeric(15, 2) [not null]
  chenh_lech_tien_mat numeric(15, 2) [not null]
  tong_so_phieu_thu int [not null]
  tong_so_phieu_chi int [not null]
  trang_thai varchar(30) [not null]
  ghi_chu text
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'Biên bản bàn giao và khóa sổ doanh thu tiền mặt ca trực của thu ngân'
}

Table danh_gia_dich_vu {
  luot_kham_id int [not null, unique]
  benh_nhan_id int [not null]
  bac_si_id int [not null]
  so_sao_bac_si int [not null]
  so_sao_phong_kham int [not null]
  tieu_chi_hai_long json
  nhan_xet text
  an_danh boolean [not null]
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Khảo sát sự hài lòng của bệnh nhân sau khi kết thúc lượt khám'
}

Table giay_phep_co_so {
  so_giay_phep varchar(100) [not null, unique]
  ten_co_so varchar(255) [not null]
  ngay_cap datetime [not null]
  ngay_het_han datetime
  pham_vi_hoat_dong text
  trang_thai varchar(50) [not null]
  tep_dinh_kem_url varchar(500)
  ghi_chu text
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'Giấy phép hoạt động khám chữa bệnh của cơ sở y tế theo quy định Bộ Y tế'
}

Table lich_su_giay_phep_bac_si {
  bac_si_id int [not null]
  trang_thai_cu varchar(50)
  trang_thai_moi varchar(50) [not null]
  nguoi_thuc_hien_id int
  ly_do text [not null]
  ngay_hieu_luc datetime [not null]
  ghi_chu text
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'Lịch sử cấp đổi, đình chỉ hoặc gia hạn chứng chỉ hành nghề của bác sĩ'
}

Table nhat_ky_truy_cap_y_te {
  user_id int [not null]
  user_role varchar(50) [not null]
  patient_id int [not null]
  action varchar(50) [not null]
  resource_type varchar(50) [not null]
  resource_id int
  purpose varchar(255) [not null]
  client_ip varchar(50)
  timestamp datetime [not null]
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'Audit log ghi vết truy cập và thay đổi dữ liệu bệnh án theo chuẩn an toàn TT32'
}

Table hop_dong_kham_doan {
  ma_hop_dong varchar(50) [not null, unique]
  ten_cong_ty varchar(255) [not null]
  ma_so_thue varchar(50)
  nguoi_dai_dien varchar(150) [not null]
  so_dien_thoai varchar(30) [not null]
  so_luong_nhan_vien int [not null]
  ngay_bat_dau date [not null]
  ngay_ket_thuc date [not null]
  gia_tri_hop_dong numeric(15, 2) [not null]
  trang_thai varchar(30) [not null]
  ghi_chu text
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Hợp đồng khám sức khỏe định kỳ cho doanh nghiệp/cơ quan'
}

Table nhan_vien_kham_doan {
  hop_dong_id int [not null]
  ma_nhan_vien varchar(50) [not null]
  ho_ten varchar(150) [not null]
  ngay_sinh date
  gioi_tinh varchar(10)
  phong_ban varchar(100)
  so_dien_thoai varchar(30)
  cccd_so varchar(20)
  benh_nhan_id int
  phan_loai_suc_khoe varchar(20)
  trang_thai_kham varchar(30) [not null]
  ket_luan text
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Danh sách nhân sự thuộc đoàn khám sức khỏe doanh nghiệp'
}

Table goi_dich_vu {
  ma_goi varchar(50) [not null, unique]
  ten_goi varchar(255) [not null]
  chuyen_khoa_chinh_id int
  doi_tuong_ap_dung varchar(100) [not null]
  don_gia_niem_yet numeric(15, 2) [not null]
  don_gia_khuyen_mai numeric(15, 2) [not null]
  mo_ta text
  is_active boolean [not null]
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Danh mục gói khám sức khỏe tổng quát, tầm soát chuyên sâu'
}

Table chi_tiet_goi_dich_vu {
  goi_dich_vu_id int [not null]
  dich_vu_id int [not null]
  so_luong int [not null]
  ghi_chu text
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Danh sách các dịch vụ thành phần nằm trong gói khám'
}

Table dang_ky_goi_kham {
  ma_dang_ky varchar(50) [not null, unique]
  benh_nhan_id int [not null]
  goi_dich_vu_id int [not null]
  ngay_dang_ky date [not null]
  han_su_dung date [not null]
  tong_so_dich_vu int [not null]
  so_dich_vu_da_dung int [not null]
  trang_thai varchar(30) [not null]
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Hợp đồng mua gói dịch vụ khám của bệnh nhân'
}

Table lieu_trinh_dieu_tri {
  ma_lieu_trinh varchar(50) [not null, unique]
  ten_lieu_trinh varchar(255) [not null]
  benh_nhan_id int [not null]
  bac_si_phu_trach_id int [not null]
  tong_so_buoi int [not null]
  so_buoi_da_thuc_hien int [not null]
  ngay_bat_dau date [not null]
  ngay_du_kien_ket_thuc date
  muc_tieu_dieu_tri text
  trang_thai varchar(30) [not null]
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Kế hoạch điều trị dài ngày (Vật lý trị liệu, nha khoa, phục hồi chức năng)'
}

Table buoi_dieu_tri {
  lieu_trinh_id int [not null]
  so_thu_tu_buoi int [not null]
  ngay_thuc_hien datetime [not null]
  ky_thuat_vien_id int
  noi_dung_thuc_hien text
  danh_gia_tien_trien text
  trang_thai varchar(30) [not null]
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Từng buổi thực hiện thủ thuật trong liệu trình điều trị'
}

Table mau_bieu_y_te {
  ma_mau varchar(50) [not null, unique]
  ten_mau varchar(255) [not null]
  loai_mau varchar(30) [not null]
  chuyen_khoa_id int
  bac_si_tao_id int
  noi_dung_text text [not null]
  is_public boolean [not null]
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'Mẫu biểu văn bản y tế động phục vụ in ấn và liên thông báo cáo'
}

Table cau_hoi_y_khoa {
  tieu_de varchar(255) [not null]
  chuyen_muc varchar(50) [not null]
  cau_hoi text [not null]
  cau_tra_loi text
  bac_si_tra_loi_id int
  luot_xem int [not null]
  is_published boolean [not null]
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Cổng hỏi đáp sức khỏe trực tuyến bác sĩ - bệnh nhân'
}

Table bai_viet_tin_tuc {
  tieu_de varchar(255) [not null]
  slug varchar(255) [not null, unique]
  chuyen_muc varchar(50) [not null]
  anh_dai_dien_url varchar(500)
  tom_tat text
  noi_dung_html text [not null]
  tac_gia varchar(150) [not null]
  luot_xem int [not null]
  is_published boolean [not null]
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: '[Phase 2] Bài viết cẩm nang y tế, tin tức sức khỏe phòng khám'
}

Table thong_bao {
  tai_khoan_id int [not null]
  tieu_de varchar(255) [not null]
  noi_dung text [not null]
  loai_thong_bao varchar(50) [not null]
  lien_ket_url varchar(255)
  du_lieu_phu_json json
  da_doc boolean [not null]
  thoi_gian_doc datetime
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'Hệ thống tin nhắn/thông báo đẩy cho bệnh nhân và nhân viên y tế'
}

Table he_thong_trang_thai_bff {
  collection_key varchar(100) [not null, unique]
  data_json json [not null]
  updated_by_id int
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'Lưu trữ trạng thái tiến trình giao dịch nghiệp vụ phía Backend For Frontend'
}

