  bac_si_ket_luan_id int
  id int [pk, increment]
  created_at datetime [not null]
  updated_at datetime [not null]
  Note: 'Hồ sơ khám thể lực chuyên sâu (tai, mũi, họng, răng hàm mặt, mắt)'
}

Table khoa_so_ca_truc {
  ma_khoa_so varchar(50) [not null, unique]
  ca_lam_viec varchar(20) [not null]
  ngay_khoa_so date [not null]
